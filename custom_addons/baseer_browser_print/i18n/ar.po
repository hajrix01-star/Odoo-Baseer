#. module: baseer_browser_print
#. odoo-javascript
#: code:addons/baseer_browser_print/static/src/print_dialog.js:0
msgid "If the print window does not open, use the PDF viewer's print button or download the PDF."
msgstr "إذا لم تفتح نافذة الطباعة، استخدم زر الطباعة داخل عارض PDF أو حمّل الملف."

#. module: baseer_browser_print
#. odoo-javascript
#: code:addons/baseer_browser_print/static/src/report_transport.js:0
