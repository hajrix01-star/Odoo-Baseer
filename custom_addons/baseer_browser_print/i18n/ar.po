msgid "Print"
msgstr "طباعة"

#. module: baseer_browser_print
#. odoo-javascript
#: code:addons/baseer_browser_print/static/src/print_dialog.js:0
msgid "Download PDF"
msgstr "تحميل PDF"

#. module: baseer_browser_print
#. odoo-javascript
#: code:addons/baseer_browser_print/static/src/print_dialog.js:0
msgid "Close"
msgstr "إغلاق"

#. module: baseer_browser_print
#. odoo-javascript
#: code:addons/baseer_browser_print/static/src/print_dialog.js:0
msgid "PDF preview"
msgstr "معاينة PDF"

#. module: baseer_browser_print
#. odoo-javascript
#: code:addons/baseer_browser_print/static/src/print_dialog.js:0
msgid "Alternative preview"
