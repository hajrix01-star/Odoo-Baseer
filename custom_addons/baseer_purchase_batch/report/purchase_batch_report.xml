<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="paperformat_purchase_batch" model="report.paperformat">
        <field name="name">Baseer Purchase Batch</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">38</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_spacing">28</field>
        <field name="dpi">90</field>
    </record>
    <record id="action_report_purchase_batch" model="ir.actions.report">
        <field name="name">Purchase Batch Summary</field>
        <field name="model">baseer.purchase.batch</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">baseer_purchase_batch.report_purchase_batch</field>
        <field name="report_file">baseer_purchase_batch.report_purchase_batch</field>
        <field name="binding_model_id" ref="model_baseer_purchase_batch"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_purchase_batch"/>
        <field name="print_report_name">'Purchase Batch - %s' % object.name</field>
    </record>
    <template id="report_purchase_batch_document">
        <t t-set="d" t-value="o._get_print_data()"/>
        <t t-call="web.external_layout">
            <t t-call="baseer_report_layout.arabic_pdf_font_styles"/>
            <div class="page eh_pdf_page baseer_arabic_pdf"
                 t-att-dir="'rtl' if (env.context.get('lang') or '').startswith('ar') else 'ltr'">
                <style>
                    .baseer_batch_summary { width: 100%; border-collapse: collapse; font-size: 11px; }
                    .baseer_batch_summary th { background: #e9f1ed; color: #173f3a; font-weight: 700; padding: 8px 6px; border-bottom: 1px solid #afc7ba; }
                    .baseer_batch_summary td { padding: 7px 6px; border-bottom: 1px solid #d8e3dc; vertical-align: top; }
                    .baseer_batch_summary tr { page-break-inside: avoid; }
                    .baseer_batch_summary thead { display: table-header-group; }
                    .baseer_batch_summary .baseer_batch_money { direction: ltr; text-align: right; white-space: nowrap; }
                    .baseer_batch_summary .baseer_batch_detail { color: #596b60; font-size: 10px; }
                    .baseer_batch_summary .baseer_batch_total td { background: #edf4f0; font-weight: 700; border-top: 2px solid #739485; }
                    .baseer_batch_meta { font-size: 12px; margin-bottom: 16px; }
                </style>
                <h2><span>Purchase Batch Summary</span> — <span t-out="d['name']"/></h2>
                <div class="baseer_batch_meta">
                    <strong>Company:</strong> <span t-field="o.company_id.name"/>
                    <span class="mx-3">|</span>
                    <strong>Entry Date:</strong> <span dir="ltr" t-out="d['entry_date']"/>
                    <span class="mx-3">|</span>
                    <strong>Status:</strong> <span t-out="d['state']"/>
                    <span class="mx-3">|</span>
                    <strong>Currency:</strong> <span t-field="o.currency_id.name"/>
                </div>
                <table class="baseer_batch_summary eh_pdf_table">
                    <thead>
                        <tr>
                            <th style="width:10%">Invoice Date</th>
                            <th style="width:23%">Supplier / Reference</th>
                            <th style="width:24%">Type / Category / Description</th>
                            <th style="width:13%">Payment Method</th>
                            <th style="width:10%">Amount incl. VAT</th>
                            <th style="width:10%">Tax Amount</th>
                            <th style="width:10%">Net</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="d['rows']" t-as="line">
                            <td><span dir="ltr" t-out="line['date']"/></td>
                            <td>
                                <strong t-out="line['supplier']"/>
                                <div class="baseer_batch_detail" t-out="line['reference']"/>
                                <div t-if="line['invoice']" class="baseer_batch_detail" t-out="line['invoice']"/>
                            </td>
                            <td>
                                <span t-out="line['type']"/> · <span t-out="line['category']"/>
                                <div t-if="line['description']" class="baseer_batch_detail" t-out="line['description']"/>
                            </td>
                            <td t-out="line['payment']"/>
                            <td class="baseer_batch_money" t-out="line['gross']"/>
                            <td class="baseer_batch_money">
                                <span t-out="line['tax']"/>
                                <div class="baseer_batch_detail" t-out="line['tax_name']"/>
                            </td>
                            <td class="baseer_batch_money" t-out="line['net']"/>
                        </tr>
                        <tr t-if="not d['rows']"><td colspan="7">No invoices in this batch.</td></tr>
                        <tr class="baseer_batch_total">
                            <td colspan="4">Total</td>
                            <td class="baseer_batch_money" t-out="d['totals']['gross']"/>
                            <td class="baseer_batch_money" t-out="d['totals']['tax']"/>
                            <td class="baseer_batch_money" t-out="d['totals']['net']"/>
                        </tr>
                    </tbody>
                </table>
                <p class="mt-3 text-muted" style="font-size:11px;">The entry date is administrative. Paid rows use their invoice date as the payment date; credit rows remain payable.</p>
            </div>
        </t>
    </template>
    <template id="report_purchase_batch">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="baseer_purchase_batch.report_purchase_batch_document"/>
            </t>
        </t>
    </template>
</odoo>
