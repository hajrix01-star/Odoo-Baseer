<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_closure_list" model="ir.ui.view">
        <field name="name">baseer.pos.closure.list</field><field name="model">baseer.pos.closure</field>
        <field name="arch" type="xml"><list decoration-muted="state == 'cancelled'">
            <field name="name"/><field name="company_id" groups="base.group_multi_company"/>
            <field name="date_from" widget="baseer_latin_date" options="{'numeric': True}"/>
            <field name="date_to" widget="baseer_latin_date" options="{'numeric': True}"/>
            <field name="period_scope"/><field name="reason"/><field name="notes" optional="show"/>
            <field name="state" widget="badge" decoration-success="state == 'confirmed'"/>
        </list></field>
    </record>
    <record id="view_pos_closure_form" model="ir.ui.view">
        <field name="name">baseer.pos.closure.form</field><field name="model">baseer.pos.closure</field>
        <field name="arch" type="xml"><form string="Operating closure">
            <header>
                <button name="action_confirm" type="object" string="Confirm closure" class="oe_highlight" invisible="state != 'draft'"/>
                <button name="action_cancel" type="object" string="Cancel closure" invisible="state != 'confirmed'" groups="point_of_sale.group_pos_manager" confirm="Cancel this closure and allow sales entries for its dates?"/>
                <button name="action_archive" type="object" string="Archive" invisible="is_archived" groups="point_of_sale.group_pos_manager"/>
                <button name="action_unarchive" type="object" string="Unarchive" invisible="not is_archived" groups="point_of_sale.group_pos_manager"/>
                <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
            </header>
            <sheet><widget name="web_ribbon" title="Archived" bg_color="text-bg-secondary" invisible="not is_archived"/><field name="is_archived" invisible="1"/><div class="oe_title"><h1><field name="name"/></h1></div>
                <group><group string="Closure period">
                    <field name="company_id" readonly="1" options="{'no_open': True}"/>
                    <field name="date_from" widget="baseer_latin_date" options="{'numeric': True}" readonly="state != 'draft'"/>
                    <field name="date_to" widget="baseer_latin_date" options="{'numeric': True}" readonly="state != 'draft'"/>
                    <field name="period_scope" widget="radio" options="{'horizontal': True}" readonly="state != 'draft'"/>
                </group><group string="Reason">
                    <field name="reason" readonly="state != 'draft'"/>
                    <field name="notes" placeholder="Optional closure details" readonly="state != 'draft'"/>
                </group></group>
                <p class="text-muted">Dates include the first and last day. A closure records no sales or accounting entries.</p>
                <group invisible="state == 'draft'"><group>
                    <field name="confirmed_by_id"/><field name="confirmed_at" widget="baseer_latin_datetime" options="{'numeric': True}"/>
                </group><group>
                    <field name="cancellation_reason" invisible="state == 'draft'" readonly="state == 'cancelled'" groups="point_of_sale.group_pos_manager"/>
                    <field name="cancelled_by_id" invisible="state != 'cancelled'"/>
                    <field name="cancelled_at" invisible="state != 'cancelled'" widget="baseer_latin_datetime" options="{'numeric': True}"/>
                </group></group>
            </sheet>
        </form></field>
    </record>
    <record id="action_pos_closure" model="ir.actions.act_window">
        <field name="name">Operating closures</field><field name="res_model">baseer.pos.closure</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_pos_closure" name="Operating closures" parent="point_of_sale.menu_point_root" action="action_pos_closure" sequence="3" groups="point_of_sale.group_pos_user"/>
</odoo>
