<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_daily_report_form" model="ir.ui.view">
        <field name="name">baseer.pos.daily.report.form</field><field name="model">baseer.pos.daily.report</field>
        <field name="arch" type="xml"><form string="Daily sales and customers" delete="0" duplicate="0">
            <header><button name="action_generate" type="object" string="Show report" class="oe_highlight"/>
                <button name="action_timeline" type="object" string="Daily timeline" icon="fa-line-chart" invisible="not generated or not operating_days"/>
            </header><sheet>
                <field name="currency_id" invisible="1"/><field name="generated" invisible="1"/>
                <h1>Daily sales and customers</h1>
                <group><group><field name="company_id" options="{'no_open': True}"/></group><group>
                    <field name="date_from" widget="baseer_latin_date" options="{'numeric': True}"/>
                    <field name="date_to" widget="baseer_latin_date" options="{'numeric': True}"/>
                </group></group>
                <div invisible="not generated">
                    <group><group string="Daily averages — complete operating days">
                        <field name="average_daily_sales" widget="monetary" invisible="not operating_days"/>
                        <field name="average_daily_customers" invisible="not operating_days"/>
                        <div class="text-muted" invisible="operating_days">Daily averages are unavailable until a complete operating day is recorded.</div>
                        <field name="operating_days"/>
                        <field name="complete_sales" widget="monetary"/>
                        <field name="complete_customers"/>
                    </group><group string="Period coverage">
                        <field name="recorded_sales" widget="monetary"/>
                        <field name="recorded_customers"/>
                        <field name="closed_days"/><field name="incomplete_days"/><field name="missing_days"/>
                    </group></group>
                    <p class="text-muted">Each complete operating date counts once, regardless of its shifts. Closed and incomplete dates are excluded from daily averages. Recorded totals include approved entries from incomplete dates. Sales include VAT.</p>
                    <field name="line_ids" mode="list,kanban" nolabel="1">
                        <list create="0" edit="0" delete="0" decoration-muted="status in ('closed', 'missing')">
                            <field name="currency_id" column_invisible="True"/><field name="has_sales" column_invisible="True"/>
                            <field name="summary_ids" column_invisible="True"/><field name="closure_ids" column_invisible="True"/>
                            <field name="business_date" widget="baseer_latin_date" options="{'numeric': True}"/>
                            <field name="status" widget="badge" decoration-success="status == 'complete'" decoration-warning="status == 'incomplete'"/>
                            <field name="sales" widget="monetary" invisible="not has_sales"/><field name="customers" invisible="not has_sales"/>
                            <button name="action_summaries" type="object" string="Summaries" icon="fa-external-link" invisible="not summary_ids"/>
                            <button name="action_closures" type="object" string="Closures" icon="fa-calendar-times-o" invisible="not closure_ids"/>
                        </list>
                        <kanban><field name="has_sales"/><field name="summary_ids"/><field name="closure_ids"/><field name="currency_id"/>
                            <templates><t t-name="card"><div class="d-flex justify-content-between"><strong><field name="business_date" widget="baseer_latin_date" options="{'numeric': True}"/></strong><field name="status"/></div>
                                <div class="d-flex justify-content-between mt-2" t-if="record.has_sales.raw_value"><field name="sales" widget="monetary"/><span><field name="customers"/> customers</span></div>
                                <div class="d-flex gap-2 mt-2"><button name="action_summaries" type="object" class="btn btn-link p-0" invisible="not summary_ids">Summaries</button><button name="action_closures" type="object" class="btn btn-link p-0" invisible="not closure_ids">Closures</button></div>
                            </t></templates>
                        </kanban>
                    </field>
                </div>
            </sheet>
        </form></field>
    </record>
    <record id="view_pos_daily_line_list" model="ir.ui.view">
        <field name="name">baseer.pos.daily.report.line.list</field><field name="model">baseer.pos.daily.report.line</field>
        <field name="arch" type="xml"><list create="0" edit="0" delete="0">
            <field name="currency_id" column_invisible="True"/><field name="has_sales" column_invisible="True"/>
            <field name="business_date" widget="baseer_latin_date" options="{'numeric': True}"/><field name="status"/>
            <field name="sales" invisible="not has_sales" widget="monetary"/><field name="customers" invisible="not has_sales"/>
            <button name="action_summaries" type="object" string="Summaries" icon="fa-external-link"/>
        </list></field>
    </record>
    <record id="view_pos_daily_line_graph" model="ir.ui.view">
        <field name="name">baseer.pos.daily.report.line.graph</field><field name="model">baseer.pos.daily.report.line</field>
        <field name="arch" type="xml"><graph string="Completed operating days" type="line" sample="0">
            <field name="date_label"/><field name="sales" type="measure"/><field name="customers" type="measure"/>
        </graph></field>
    </record>
    <record id="action_pos_daily_report" model="ir.actions.act_window">
        <field name="name">Daily sales and customers</field><field name="res_model">baseer.pos.daily.report</field><field name="view_mode">form</field><field name="target">current</field>
    </record>
    <menuitem id="menu_pos_daily_report" name="Daily sales and customers" parent="point_of_sale.menu_point_rep" action="action_pos_daily_report" sequence="18" groups="point_of_sale.group_pos_user"/>
</odoo>
