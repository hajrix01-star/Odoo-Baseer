<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_summary_list" model="ir.ui.view">
        <field name="name">baseer.pos.summary.list</field>
        <field name="model">baseer.pos.summary</field>
        <field name="arch" type="xml">
            <list default_order="business_date desc, id desc" decoration-muted="state == 'draft'">
                <field name="currency_id" column_invisible="True"/>
                <field name="name"/>
                <field name="business_date" widget="baseer_latin_date" options="{'numeric':True}"/>
                <field name="period_scope"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="customer_count" sum="Customers"/>
                <field name="amount_gross" widget="monetary" sum="Total sales"/>
                <field name="amount_tax" widget="monetary" sum="Tax" optional="hide"/>
                <field name="amount_net" widget="monetary" sum="Net sales" optional="hide"/>
                <field name="average_per_customer" widget="monetary" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>
    <record id="view_summary_search" model="ir.ui.view">
        <field name="name">baseer.pos.summary.search</field>
        <field name="model">baseer.pos.summary</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company_id"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <separator/>
                <filter name="morning_only" string="Morning" domain="[('period_scope','=','morning')]"/>
                <filter name="evening_only" string="Evening" domain="[('period_scope','=','evening')]"/>
                <filter name="all_day_only" string="All Day" domain="[('period_scope','=','all')]"/>
                <separator/>
                <filter name="business_date" string="Sales date" date="business_date"/>
                <group>
                    <filter name="by_month" string="Month" context="{'group_by':'business_date:month'}"/>
                    <filter name="by_company" string="Company" context="{'group_by':'company_id'}"/>
                    <filter name="by_shift" string="Shift" context="{'group_by':'period_scope'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_summary_form" model="ir.ui.view">
        <field name="name">baseer.pos.summary.form</field>
        <field name="model">baseer.pos.summary</field>
        <field name="arch" type="xml">
            <form string="External sales summary" class="baseer_pos_summary_form">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="state != 'draft' or not is_current_company" confirm="Approve this summary and post its sales and payments?"/>
                    <button name="action_approve_and_share" type="object" string="Approve and open WhatsApp" invisible="state != 'draft' or not is_current_company" confirm="Approve this summary and prepare its WhatsApp message?"/>
                    <button name="action_share_whatsapp" type="object" string="Open WhatsApp" icon="fa-whatsapp" invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <field name="is_current_company" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="order_id" invisible="1"/>
                    <field name="session_id" invisible="1"/>
                    <field name="move_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_order" type="object" class="oe_stat_button" icon="fa-shopping-cart" invisible="not order_id"><span class="o_stat_text">POS order</span></button>
                        <button name="action_view_session" type="object" class="oe_stat_button" icon="fa-desktop" invisible="not session_id"><span class="o_stat_text">Session</span></button>
                        <button name="action_view_moves" type="object" class="oe_stat_button" icon="fa-book" invisible="not move_id"><span class="o_stat_text">Journal entries</span></button>
                    </div>
                    <div class="alert alert-info" role="status" invisible="is_current_company">Switch to this summary's company to edit or approve it.</div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <field name="config_id" invisible="1"/>
                    <group class="baseer_pos_header">
                        <group string="Sales day">
                            <field name="company_id" readonly="1" options="{'no_open': True}"/>
                            <field name="business_date" widget="baseer_latin_date" options="{'numeric':True}" readonly="state != 'draft' or not is_current_company"/>
                            <field name="day_schedule" widget="radio" options="{'horizontal': True}" readonly="state != 'draft' or not is_current_company"/>
                            <field name="period_scope" widget="baseer_summary_shift_radio" options="{'horizontal': True}" invisible="day_schedule != 'split'" readonly="state != 'draft' or not is_current_company"/>
                        </group>
                        <group string="Customers">
                            <field name="customer_count" class="baseer_pos_customer_input" readonly="state != 'draft' or not is_current_company or zero_sales"/>
                            <field name="zero_sales" widget="boolean_toggle" options="{'autosave': False}" readonly="state != 'draft' or not is_current_company"/>
                        </group>
                    </group>
                    <div class="baseer_pos_payment_section" invisible="zero_sales">
                        <separator string="Sales by payment method"/>
                        <p class="text-muted" invisible="state != 'draft'">Enter the full sales amount for each payment method, including VAT.</p>
                        <field name="allocation_ids" widget="baseer_payment_amount_grid" readonly="state != 'draft' or not is_current_company" mode="list" nolabel="1">
                            <list editable="bottom" create="0" delete="0" limit="25">
                                <field name="currency_id" column_invisible="True"/>
                                <field name="company_id" column_invisible="True"/>
                                <field name="sequence" column_invisible="True"/>
                                <field name="payment_method_id" readonly="1" force_save="1" options="{'no_create':True,'no_open':True}"/>
                                <field name="amount" widget="monetary" options="{'no_symbol': True}"/>
                            </list>
                        </field>
                    </div>
                    <div class="alert alert-info" role="status" invisible="not zero_sales">This shift operated without sales and creates no accounting entry. The day counts once in daily averages when all its scheduled shifts are recorded or closed.</div>
                    <div class="baseer_pos_metrics">
                        <div class="baseer_pos_metric">
                            <span class="text-muted">Total including VAT</span>
                            <field name="amount_gross" widget="monetary" nolabel="1"/>
                        </div>
                        <div class="baseer_pos_metric">
                            <span class="text-muted">Customers</span>
                            <field name="customer_count" readonly="1" nolabel="1"/>
                        </div>
                        <div class="baseer_pos_metric">
                            <span class="text-muted">Average per customer</span>
                            <field name="average_per_customer" widget="monetary" nolabel="1"/>
                        </div>
                    </div>
                    <group class="baseer_pos_totals">
                        <group>
                            <field name="notes" placeholder="Optional notes" readonly="state != 'draft' or not is_current_company"/>
                            <field name="attachment_ids" widget="many2many_binary" readonly="state != 'draft' or not is_current_company"/>
                        </group>
                        <group>
                            <field name="amount_net" widget="monetary"/>
                            <field name="amount_tax" widget="monetary"/>
                        </group>
                    </group>
                    <group invisible="state != 'approved'"><field name="approved_by_id"/><field name="approved_at" widget="baseer_latin_datetime" options="{'numeric':True}"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_summary_pivot" model="ir.ui.view">
        <field name="name">baseer.pos.summary.pivot</field><field name="model">baseer.pos.summary</field>
        <field name="arch" type="xml"><pivot string="Sales and customers"><field name="company_id" type="row"/><field name="business_date" type="col" interval="month"/><field name="amount_gross" type="measure"/><field name="customer_count" type="measure"/></pivot></field>
    </record>
    <record id="view_summary_graph" model="ir.ui.view">
        <field name="name">baseer.pos.summary.graph</field><field name="model">baseer.pos.summary</field>
        <field name="arch" type="xml"><graph string="Sales and customers" type="bar"><field name="business_date" interval="month"/><field name="amount_gross" type="measure"/></graph></field>
    </record>
    <record id="action_summary" model="ir.actions.act_window">
        <field name="name">External sales summaries</field><field name="res_model">baseer.pos.summary</field><field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Enter your external POS sales summary</p><p>One summary for each day or shift, using the active company.</p></field>
    </record>
    <record id="action_summary_analysis" model="ir.actions.act_window">
        <field name="name">Sales and customers</field><field name="res_model">baseer.pos.summary</field><field name="view_mode">pivot,graph,list,form</field><field name="domain">[('state','=','approved')]</field>
    </record>
    <menuitem id="menu_summary" name="External sales summaries" parent="point_of_sale.menu_point_root" action="action_summary" sequence="2" groups="point_of_sale.group_pos_user"/>
    <menuitem id="menu_summary_analysis" name="Sales and customers" parent="point_of_sale.menu_point_rep" action="action_summary_analysis" sequence="20" groups="point_of_sale.group_pos_user"/>
</odoo>
