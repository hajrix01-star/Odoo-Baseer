msgstr "الجرد النقدي لا يطابق الدفعات النقدية في الملخص الخارجي."

#. module: baseer_pos_summary
#. odoo-python
#: code:addons/baseer_pos_summary/models/correction.py:0
msgid ""
"The native correction entries did not reverse the original summary exactly."
msgstr "لم تعكس قيود التصحيح الأصلية مبالغ الملخص بالكامل وبالدقة المطلوبة."

#. module: baseer_pos_summary
#. odoo-python
#: code:addons/baseer_pos_summary/models/pos_native.py:0
