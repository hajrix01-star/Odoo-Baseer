<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="paperformat_cash_portrait" model="report.paperformat">
        <field name="name">Baseer Cash - A4 Portrait</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">14</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
    <template id="report_cash_note" inherit_id="eh_account_dynamic_reports.report_dynamic_pdf_template">
        <xpath expr="//div[hasclass('eh_pdf_page')]" position="attributes">
            <attribute name="t-att-data-baseer-cash-pdf">'true' if r.get('doc').code == 'baseer_cash_categories' else None</attribute>
        </xpath>
        <xpath expr="//div[hasclass('eh_pdf_meta')]" position="attributes">
            <attribute name="t-if">not (r.get('doc').code == 'baseer_cash_categories' and r.get('payload').get('meta', {}).get('baseer_months'))</attribute>
        </xpath>
        <xpath expr="//div[hasclass('eh_pdf_meta')]" position="after">
            <div t-if="r.get('doc').code == 'baseer_cash_categories' and r.get('payload').get('meta', {}).get('baseer_months')"
                 class="baseer_cash_pdf_meta">
                <div><strong t-out="r['baseer_labels']['months']"/> <span dir="ltr" t-out="', '.join(r.get('payload')['meta']['baseer_months'])"/></div>
                <div><strong t-out="r['baseer_labels']['currency']"/> <span t-out="r.get('payload').get('currency', {}).get('name')"/> ·
                    <span t-out="r['baseer_labels']['tax']"/>
                </div>
                <div><strong t-out="r['baseer_labels']['sales']"/> <span dir="ltr" t-out="r.get('payload')['meta'].get('exact_sales_collections')"/></div>
            </div>
            <style t-if="r.get('doc').code == 'baseer_cash_categories'">
                [data-baseer-cash-pdf="true"] .baseer_cash_pdf_meta { font-size:9pt; line-height:1.7; margin-bottom:12pt; }
                [data-baseer-cash-pdf="true"].baseer_arabic_pdf .baseer_cash_pdf_meta,
                [data-baseer-cash-pdf="true"].baseer_arabic_pdf .baseer_cash_pdf_meta * { font-family:'Baseer Plex Arabic', sans-serif !important; }
                [data-baseer-cash-pdf="true"] { max-width:175mm; margin-left:auto; margin-right:auto; }
                [data-baseer-cash-pdf="true"] .eh_pdf_table { width:100%; table-layout:fixed; font-size:9pt; }
                [data-baseer-cash-pdf="true"] .eh_pdf_table th:first-child,
                [data-baseer-cash-pdf="true"] .eh_pdf_table td:first-child { width:30%; white-space:normal; }
                [data-baseer-cash-pdf="true"] .eh_pdf_table td { padding:4pt 3pt; overflow-wrap:break-word; }
                [data-baseer-cash-pdf="true"] .eh_pdf_table th { white-space:normal; font-size:8pt; }
                [data-baseer-cash-pdf="true"] .eh_pdf_table thead th { background:#edf5f1 !important; color:#173f3a !important; border-bottom:1px solid #bfd7ca !important; }
                [data-baseer-cash-pdf="true"] .eh_pdf_table tbody td { background:#fff; border-top:1px solid #d8e6df; border-left:0; border-right:0; }
                [data-baseer-cash-pdf="true"] .eh_pdf_table .eh_pdf_section_row td,
                [data-baseer-cash-pdf="true"] .eh_pdf_table .baseer_pdf_group td { background:#d5e7e1 !important; color:#173f3a; }
                [data-baseer-cash-pdf="true"] .eh_pdf_table .baseer_pdf_net td { background:#edf5f1 !important; border-top:2px solid #00796b; }
                [data-baseer-cash-pdf="true"] .eh_pdf_table .baseer_pdf_detail td,
                [data-baseer-cash-pdf="true"] .eh_pdf_table .baseer_pdf_note td { background:#fff !important; border-top:1px solid #d8e6df; font-weight:400; }
                [data-baseer-cash-pdf="true"] .eh_pdf_table td.text-end { color:#006b5f; }
                [data-baseer-cash-pdf="true"] .eh_pdf_table td.baseer_pdf_negative { color:#b62b42 !important; }
                [data-baseer-cash-pdf="true"] .eh_pdf_table { border:1px solid #d8e6df; }
            </style>
        </xpath>
        <xpath expr="//td[@t-att-class=&quot;'text-end' if cell.get('align_right') else ''&quot;]" position="attributes">
            <attribute name="t-att-class">('text-end' if cell.get('align_right') else '') + (' baseer_pdf_negative' if r.get('doc').code == 'baseer_cash_categories' and isinstance(cell.get('value'), (int, float)) and cell.get('value') &lt; 0 else '')</attribute>
        </xpath>
        <xpath expr="//td[contains(@t-att-style, 'padding-left')]" position="attributes">
            <attribute name="t-att-style">('padding-right: %sem;' if r.get('doc').code == 'baseer_cash_categories' and (env.context.get('lang') or '').startswith('ar') else 'padding-left: %sem;') % str((line.get('level') or 0) * 1.0)</attribute>
        </xpath>
    </template>
</odoo>
