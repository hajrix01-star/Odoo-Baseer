<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_advance_entry_company" model="ir.rule">
        <field name="name">Advance entries: authorized companies</field>
        <field name="model_id" ref="model_baseer_advance_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_advance_entry_cashier_own" model="ir.rule">
        <field name="name">Cashier: own advance entries</field>
        <field name="model_id" ref="model_baseer_advance_entry"/>
        <field name="domain_force">[('create_uid', '=', user.id)] if user.has_group('baseer_access_roles.group_cashier') else [(1, '=', 1)]</field>
    </record>
</odoo>
