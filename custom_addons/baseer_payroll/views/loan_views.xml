<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_baseer_loan_list" model="ir.ui.view"><field name="name">baseer.hr.loan.list</field><field name="model">baseer.hr.loan</field><field name="arch" type="xml">
        <list string="Employee Loans" decoration-muted="state == 'cancel'" decoration-success="state == 'closed'">
            <field name="name"/><field name="employee_id" string="Employee"/><field name="date" string="Date" widget="baseer_latin_date"/><field name="company_id" string="Company" groups="base.group_multi_company"/><field name="currency_id" column_invisible="1"/>
            <field name="amount" string="Amount" sum="Total loans"/><field name="paid_amount" string="Recovered" sum="Total recovered"/><field name="balance" string="Outstanding" sum="Total outstanding"/><field name="state" string="Status" widget="badge"/>
        </list>
    </field></record>
    <record id="view_baseer_loan_form" model="ir.ui.view"><field name="name">baseer.hr.loan.form</field><field name="model">baseer.hr.loan</field><field name="arch" type="xml">
        <form string="Employee Loan" class="baseer_payroll_form">
            <header><button name="action_disburse" string="Disburse Loan" type="object" class="oe_highlight" invisible="state != 'draft'"/><button name="action_repay" string="Record Repayment" type="object" class="oe_highlight" invisible="state != 'running'"/><button name="action_cancel" string="Cancel" type="object" invisible="state != 'draft'"/><field name="state" string="Status" widget="statusbar" statusbar_visible="draft,running,closed"/></header>
            <sheet>
                <field name="currency_id" invisible="1"/>
                <div name="button_box" class="oe_button_box"><button name="action_view_moves" string="Journal Entries" type="object" class="oe_stat_button" icon="fa-book" invisible="state in ('draft','cancel')"/></div>
                <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                <group><group><field name="employee_id" string="Employee" readonly="state != 'draft'" domain="[('company_id','=',company_id)]" options="{'no_create':True}"/><field name="company_id" string="Company" readonly="1"/><field name="date" string="Date" widget="baseer_latin_date" readonly="state != 'draft'"/><field name="journal_id" string="Payment Method" readonly="state != 'draft'" domain="[('company_id','=',company_id),('type','in',['bank','cash'])]" options="{'no_create':True}"/></group>
                <group><field name="amount" string="Amount" readonly="state != 'draft'"/><field name="installment_count" string="Number of Installments" readonly="state != 'draft'"/><field name="first_due_date" string="First Installment" widget="baseer_latin_date" readonly="state != 'draft'"/><field name="paid_amount" string="Recovered"/><field name="balance" string="Outstanding" class="fw-bold"/></group></group>
                <notebook>
                    <page string="Installments"><field name="line_ids" readonly="1"><list create="0" edit="0" delete="0"><field name="sequence" string="No."/><field name="original_due_date" string="Original Due Date" widget="baseer_latin_date" optional="hide"/><field name="due_date" string="Due Date" widget="baseer_latin_date"/><field name="currency_id" column_invisible="1"/><field name="amount" string="Amount" sum="Total"/><field name="paid_amount" string="Recovered" sum="Recovered"/><field name="balance" string="Outstanding" sum="Outstanding"/><field name="state" string="Status" widget="badge"/></list></field></page>
                    <page string="Repayment History"><field name="allocation_ids" readonly="1"><list create="0" edit="0" delete="0"><field name="date" string="Date" widget="baseer_latin_date"/><field name="kind" string="Repayment Type"/><field name="currency_id" column_invisible="1"/><field name="amount" string="Amount" sum="Total recovered"/><field name="line_id" string="Installment"/><field name="move_id" string="Journal Entry"/><field name="payslip_id" string="Payslip"/></list></field></page>
                    <page string="Deferral History"><field name="defer_ids" readonly="1"><list create="0" edit="0" delete="0"><field name="date" string="Date" widget="baseer_latin_datetime"/><field name="line_id" string="Installment"/><field name="old_date" string="Previous Due Date" widget="baseer_latin_date"/><field name="new_date" string="New Due Date" widget="baseer_latin_date"/><field name="reason" string="Reason"/><field name="user_id" string="User"/></list></field></page>
                </notebook>
            </sheet><chatter/>
        </form>
    </field></record>
    <record id="view_baseer_loan_search" model="ir.ui.view"><field name="name">baseer.hr.loan.search</field><field name="model">baseer.hr.loan</field><field name="arch" type="xml"><search><field name="name"/><field name="employee_id" string="Employee"/><filter name="running" string="Outstanding Loans" domain="[('state','=','running')]"/><filter name="closed" string="Repaid Loans" domain="[('state','=','closed')]"/><filter name="draft" string="Draft" domain="[('state','=','draft')]"/><group><filter name="employee" string="Employee" context="{'group_by':'employee_id'}"/><filter name="company" string="Company" context="{'group_by':'company_id'}"/></group></search></field></record>
    <record id="action_baseer_loans" model="ir.actions.act_window"><field name="name">Employee Loans</field><field name="res_model">baseer.hr.loan</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_baseer_loan_search"/><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Manage employee loans</p><p>Track outstanding balances, installments, repayments and deferrals for each employee.</p></field></record>
    <menuitem id="menu_baseer_loans" name="Employee Loans" parent="om_hr_payroll.menu_hr_payroll_root" action="action_baseer_loans" sequence="2" groups="om_hr_payroll.group_hr_payroll_manager"/>
    <record id="view_baseer_loan_repay_form" model="ir.ui.view"><field name="name">baseer.hr.loan.repay.form</field><field name="model">baseer.hr.loan.repay</field><field name="arch" type="xml"><form string="Record Repayment"><group><field name="loan_id" string="Loan" readonly="1"/><field name="company_id" string="Company" invisible="1"/><field name="currency_id" invisible="1"/><field name="amount" string="Amount"/><field name="date" string="Date" widget="baseer_latin_date"/><field name="journal_id" string="Payment Method" domain="[('company_id','=',company_id),('type','in',['bank','cash'])]" options="{'no_create':True}"/></group><footer><button name="action_confirm" string="Confirm Repayment" type="object" class="btn-primary"/><button string="Cancel" special="cancel" class="btn-secondary"/></footer></form></field></record>
</odoo>
