<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_baseer_payroll_create" model="ir.ui.view">
        <field name="name">baseer.payroll.create.form</field><field name="model">baseer.payroll.create</field>
        <field name="arch" type="xml"><form string="Create Payroll"><group><field name="company_id" readonly="1"/><field name="baseer_month" widget="baseer_payroll_month"/></group><footer><button name="action_create" string="Create Payroll" type="object" class="btn-primary"/><button string="Cancel" special="cancel" class="btn-secondary"/></footer></form></field>
    </record>
    <record id="action_baseer_payroll_create" model="ir.actions.act_window">
        <field name="name">Create Payroll</field><field name="res_model">baseer.payroll.create</field><field name="view_mode">form</field><field name="target">new</field>
    </record>
    <record id="view_baseer_payroll_run_list" model="ir.ui.view">
        <field name="name">baseer.payroll.run.list</field>
        <field name="model">hr.payslip.run</field>
        <field name="arch" type="xml">
            <list string="Payroll Runs" decoration-muted="state == 'draft'" create="0">
                <header><button name="%(action_baseer_payroll_create)d" string="Create Payroll" type="action" display="always" class="btn-primary"/></header>
                <field name="name"/>
                <field name="baseer_month" widget="baseer_payroll_month"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="baseer_gross" sum="Total salaries"/>
                <field name="baseer_deduction" sum="Total deductions"/>
                <field name="baseer_loan_amount" sum="Total loan deductions"/>
                <field name="baseer_net" sum="Total net salaries"/>
                <field name="baseer_residual" sum="Remaining to pay"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_baseer_payroll_run_form" model="ir.ui.view">
        <field name="name">baseer.payroll.run.form</field>
        <field name="model">hr.payslip.run</field>
        <field name="arch" type="xml">
            <form string="Payroll Run" class="baseer_payroll_form" create="0">
                <header>
                    <button name="action_approve" string="Approve Payroll" type="object" class="oe_highlight" invisible="state != 'draft'" groups="om_hr_payroll.group_hr_payroll_manager"/>
                    <button name="action_pay" string="Pay Salaries" type="object" class="oe_highlight" invisible="state == 'draft' or baseer_residual &lt;= 0" groups="om_hr_payroll.group_hr_payroll_manager"/>
                    <button name="action_print" string="Print All Payslips" type="object" invisible="state == 'draft'"/>
                    <button name="action_load_employees" string="Refresh Employees" type="object" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <field name="baseer_managed" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="baseer_pending_setup_count" invisible="1"/>
                    <div class="alert alert-warning" role="alert" invisible="not baseer_pending_setup_count">Complete employee setup, then refresh this payroll. Rows requiring setup have no calculated salary or deductions; saved manual inputs will apply after refresh.</div>
                    <div class="oe_title"><h1><field name="name" readonly="1" placeholder="Monthly payroll"/></h1></div>
                    <group>
                        <group><field name="baseer_month" widget="baseer_payroll_month" readonly="state != 'draft'"/><field name="company_id" readonly="1" groups="base.group_multi_company"/></group>
                        <group><field name="date_start" widget="baseer_latin_date" readonly="1"/><field name="date_end" widget="baseer_latin_date" readonly="1"/></group>
                    </group>
                    <field name="slip_ids" mode="list,kanban" readonly="state != 'draft'">
                        <list editable="bottom" create="0" delete="0" open_form_view="1" string="Employees">
                            <field name="employee_id" readonly="1"/>
                            <field name="baseer_readiness" widget="badge" decoration-warning="baseer_readiness == 'pending'" readonly="1"/>
                            <field name="baseer_readiness_warning" readonly="1" optional="show"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="baseer_days" readonly="1" optional="hide"/>
                            <field name="baseer_basic" readonly="1" optional="hide"/>
                            <field name="baseer_overtime" readonly="1" optional="hide"/>
                            <field name="baseer_allowance" readonly="1" optional="hide"/>
                            <field name="baseer_gross" readonly="1" sum="Total salaries"/>
                            <field name="baseer_loan_amount" readonly="1" sum="Loan deductions"/>
                            <field name="baseer_defer_loan" widget="boolean_toggle"/>
                            <field name="baseer_deduction"/>
                            <field name="baseer_deduction_reason" optional="show" required="baseer_deduction &gt; 0"/>
                            <field name="baseer_net" readonly="1" sum="Net salaries"/>
                            <field name="baseer_residual" readonly="1" optional="hide"/>
                        </list>
                        <kanban class="o_kanban_mobile" create="0" delete="0">
                            <templates><t t-name="card">
                                <strong class="d-block mb-2"><field name="employee_id"/></strong>
                                <div class="text-warning"><field name="baseer_readiness_warning"/></div>
                                <div class="d-flex justify-content-between"><span t-translation="on">Salary before deductions</span><field name="baseer_gross"/></div>
                                <div class="d-flex justify-content-between"><span t-translation="on">Loan deduction</span><field name="baseer_loan_amount"/></div>
                                <div class="d-flex justify-content-between"><span t-translation="on">Other deductions</span><field name="baseer_deduction"/></div>
                                <div class="d-flex justify-content-between fw-bold mt-2"><span t-translation="on">Net salary</span><field name="baseer_net"/></div>
                            </t></templates>
                        </kanban>
                        <form string="Employee Salary">
                            <sheet>
                                <field name="currency_id" invisible="1"/><field name="state" invisible="1"/>
                                <h2><field name="employee_id" readonly="1"/></h2>
                                <div class="alert alert-warning" role="alert" invisible="not baseer_readiness_warning"><field name="baseer_readiness_warning" readonly="1"/></div>
                                <group><group string="Salary"><field name="baseer_days" readonly="1"/><field name="baseer_basic" readonly="1"/><field name="baseer_overtime" readonly="1"/><field name="baseer_allowance" readonly="1"/><field name="baseer_gross" readonly="1"/></group>
                                <group string="Deductions"><field name="baseer_loan_amount" readonly="1"/><field name="baseer_defer_loan" widget="boolean_toggle" readonly="state != 'draft'"/><field name="baseer_deduction" readonly="state != 'draft'"/><field name="baseer_deduction_reason" required="baseer_deduction &gt; 0" readonly="state != 'draft'"/><field name="baseer_net" readonly="1"/></group></group>
                            </sheet>
                        </form>
                    </field>
                    <group class="mt-4">
                        <group string="Payroll Totals"><field name="baseer_gross"/><field name="baseer_deduction"/><field name="baseer_loan_amount"/><field name="baseer_net" class="fw-bold"/></group>
                        <group string="Settlement"><field name="baseer_paid"/><field name="baseer_pending"/><field name="baseer_settled"/><field name="baseer_residual" class="fw-bold"/></group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_baseer_payroll_run_search" model="ir.ui.view">
        <field name="name">baseer.payroll.run.search</field><field name="model">hr.payslip.run</field>
        <field name="arch" type="xml"><search><field name="name"/><field name="baseer_month"/><filter name="draft" string="Draft" domain="[('state','=','draft')]"/><filter name="approved" string="Approved" domain="[('state','=','done')]"/><group><filter name="company" string="Company" context="{'group_by':'company_id'}"/></group></search></field>
    </record>
    <record id="action_baseer_payroll_runs" model="ir.actions.act_window">
        <field name="name">Payroll Runs</field><field name="res_model">hr.payslip.run</field><field name="view_mode">list,form</field>
        <field name="domain">[('baseer_managed','=',True)]</field><field name="context">{'default_baseer_managed': True}</field>
        <field name="view_ids" eval="[(5,0,0),(0,0,{'view_mode':'list','view_id':ref('view_baseer_payroll_run_list')}),(0,0,{'view_mode':'form','view_id':ref('view_baseer_payroll_run_form')})]"/>
        <field name="search_view_id" ref="view_baseer_payroll_run_search"/>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Create a monthly payroll run</p><p>Eligible employees and their due loan installments are loaded automatically.</p></field>
    </record>
    <record id="om_hr_payroll.menu_hr_payslip_run" model="ir.ui.menu">
        <field name="name">Payroll Runs</field><field name="action" ref="action_baseer_payroll_runs"/><field name="sequence">1</field>
        <field name="group_ids" eval="[(6,0,[ref('om_hr_payroll.group_hr_payroll_manager')])]"/>
    </record>
    <record id="view_baseer_payslip_controls" model="ir.ui.view">
        <field name="name">baseer.payslip.controls</field><field name="model">hr.payslip</field><field name="inherit_id" ref="om_hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='refund_sheet']" position="attributes"><attribute name="invisible">1</attribute></xpath>
            <xpath expr="//button[@name='action_payslip_cancel']" position="attributes"><attribute name="invisible">state not in ('draft', 'verify')</attribute></xpath>
            <xpath expr="//header" position="inside"><field name="baseer_managed" invisible="1"/><field name="baseer_residual" invisible="1"/><button name="action_pay" string="Pay Salary" type="object" invisible="not baseer_managed or state != 'done' or baseer_residual &lt;= 0" groups="om_hr_payroll.group_hr_payroll_manager"/></xpath>
            <xpath expr="//div[@name='button_box']" position="inside"><button name="action_view_move" type="object" class="oe_stat_button" icon="fa-book" string="Journal Entry" invisible="state != 'done'"/></xpath>
            <xpath expr="//sheet" position="inside"><div class="alert alert-warning" role="alert" invisible="not baseer_readiness_warning"><field name="baseer_readiness_warning" readonly="1"/></div></xpath>
        </field>
    </record>
</odoo>

