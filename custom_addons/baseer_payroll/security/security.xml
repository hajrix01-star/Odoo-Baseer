    <record id="rule_payslip_line_company" model="ir.rule"><field name="name">Payslip lines: allowed companies</field><field name="model_id" ref="om_hr_payroll.model_hr_payslip_line"/><field name="domain_force">[('slip_id.company_id','in',company_ids)]</field></record>
    <record id="rule_payslip_input_company" model="ir.rule"><field name="name">Payslip inputs: allowed companies</field><field name="model_id" ref="om_hr_payroll.model_hr_payslip_input"/><field name="domain_force">[('payslip_id.company_id','in',company_ids)]</field></record>
    <record id="rule_payslip_worked_company" model="ir.rule"><field name="name">Payslip worked days: allowed companies</field><field name="model_id" ref="om_hr_payroll.model_hr_payslip_worked_days"/><field name="domain_force">[('payslip_id.company_id','in',company_ids)]</field></record>
    <!-- Match the native Officer parent-payslip scope for every detail model.
         The global company rules above still intersect the manager allowance. -->
    <record id="rule_payslip_line_officer_read" model="ir.rule">
        <field name="name">Payslip lines: officer parent scope</field>
        <field name="model_id" ref="om_hr_payroll.model_hr_payslip_line"/>
        <field name="groups" eval="[(4, ref('om_hr_payroll.group_hr_payroll_user'))]"/>
        <field name="domain_force">['|', '|', ('slip_id.employee_id.user_id', '=', user.id), ('slip_id.employee_id.department_id', '=', False), ('slip_id.employee_id.department_id.manager_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_payslip_input_officer_read" model="ir.rule">
        <field name="name">Payslip inputs: officer parent scope</field>
