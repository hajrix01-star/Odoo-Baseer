        <field name="domain_force">['|', '|', ('payslip_id.employee_id.user_id', '=', user.id), ('payslip_id.employee_id.department_id', '=', False), ('payslip_id.employee_id.department_id.manager_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
